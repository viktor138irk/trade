APP_NAME=Trade Autopilot
APP_ENV=local
TRADE_MODE=demo
ENABLE_LIVE_TRADING=false
DEMO_INITIAL_BALANCE=10000
DEMO_QUOTE_ASSET=USDT
COINEX_API_BASE=https://api.coinex.com/v2
COINEX_WS_SPOT=wss://socket.coinex.com/v2/spot
DEFAULT_MARKET=BTCUSDT
MARKET_UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT,ADAUSDT,TONUSDT
DATABASE_URL=postgresql+psycopg://trade:trade@postgres:5432/trade
REDIS_URL=redis://redis:6379/0
COINEX_ACCESS_ID=
COINEX_SECRET_KEY=
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
